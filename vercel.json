{
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "private/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/googlefd62928fc13b41b4.html",
      "destination": "/googlefd62928fc13b41b4.html"
    },
    {
      "source": "/googlefd62928fc13b41b4",
      "destination": "/googlefd62928fc13b41b4.html"
    },
    {
      "source": "/api/stripe/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/private/(.*)",
      "destination": "/404"
    }
  ]
}
