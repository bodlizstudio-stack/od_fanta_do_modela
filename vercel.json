{
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "private/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/stripe/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/private/(.*)",
      "destination": "/404"
    }
  ]
}
