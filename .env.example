# ==============================================================================
# GlowUp - Od Fanta do Modela - Okoljske spremenljivke (Environment Variables)
# ==============================================================================

# 1. Stripe Secret Key (iz Stripe Dashboard -> Developers -> API keys)
# Za produkcijo: sk_live_...
# Za testiranje: sk_test_...
STRIPE_SECRET_KEY=sk_live_vnesite_vas_stripe_secret_key

# 2. Stripe Price ID za produkt "Od Fanta do Modela" (24.99 EUR)
# Najdete ga v Stripe Dashboard -> Product catalog -> Od Fanta do Modela -> Price (npr. price_1...)
# Za produkcijo: price_...
# Za testiranje: price_...
STRIPE_PRICE_ID=price_vnesite_vas_stripe_price_id

# 3. Stripe Webhook Signing Secret (iz Stripe Dashboard -> Developers -> Webhooks)
# Po registraciji webhook endpointa (https://www.glowup-slo.si/api/webhook)
# Stripe ponudi Signing secret v obliki: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_vnesite_vas_webhook_secret

# 4. Javni URL spletnega mesta (uporablja se za povratne povezave /uspeh in /preklic)
NEXT_PUBLIC_SITE_URL=https://www.glowup-slo.si
